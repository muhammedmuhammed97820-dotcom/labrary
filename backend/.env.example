PORT=5000
FRONTEND_URL=http://localhost:4200
MONGODB_URI=mongodb://127.0.0.1:27017/electronic_library
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Smart Arabic Book Importer
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-5.6-luna
OPENAI_IMPORT_BATCH_SIZE=5
IMPORT_MAX_PAGES=20
IMPORT_MAX_BOOKS=50
IMPORT_DELAY_MS=700
