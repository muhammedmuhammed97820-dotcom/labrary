PORT=5000
FRONTEND_URL=http://localhost:4200
MONGODB_URI=mongodb://127.0.0.1:27017/electronic_library
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# OpenAI-powered automatic library importer
OPENAI_API_KEY=replace-with-your-api-key
OPENAI_IMPORT_MODEL=gpt-5.6-luna
OPENAI_IMPORT_MAX_OUTPUT=12000
